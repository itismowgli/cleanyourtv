<?xml version="1.0" encoding="utf-8"?>
<!-- Menus and dialogs: one opaque rounded shape. A plain shape, not a layer-list: the panels cast a shadow
     (elevation), and Android takes the shadow's outline from this drawable, so it must be the rounded shape
     itself or the shadow shows square corners past the rounded ones. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#FF262629" android:endColor="#FF161618" />
    <corners android:radius="@dimen/corner_panel" />
</shape>
