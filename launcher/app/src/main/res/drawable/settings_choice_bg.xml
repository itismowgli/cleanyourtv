<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings choices, in the launcher's own language: white when focused (with dark text, see
     settings_choice_text), a lighter fill when chosen, a dark fill at rest, all solid so Home behind the page never shows
     through a choice. No outlines. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF4A4E55" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF24272C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
